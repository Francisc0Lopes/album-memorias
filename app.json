{
  "expo": {
    "name": "Album de Memórias",
    "slug": "memories-album",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/photos/welcome.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/photos/welcome.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5F7"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.franciscolopes.memoriesalbum",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/photos/welcome.jpg",
        "backgroundColor": "#FFF5F7"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/photos/welcome.jpg"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fcf7e11a-e425-49cb-b82a-8b0dbd13641d"
      }
    }
  }
}
